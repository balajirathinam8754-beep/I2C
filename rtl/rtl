module i2c_master (
    input clk,
    input rst,
    input start,
    input [6:0] addr,
    input rw,              // 0 = write, 1 = read
    input [7:0] data_in,
    output reg [7:0] data_out,
    output reg busy,
    output reg scl,
    inout sda
);

// Open-drain behavior
reg sda_out;
reg sda_en;
assign sda = (sda_en) ? sda_out : 1'bz;

// FSM states
parameter IDLE  = 0,
          START = 1,
          ADDR  = 2,
          ACK   = 3,
          DATA  = 4,
          STOP  = 5;

reg [2:0] state;
reg [3:0] bit_cnt;
reg [7:0] shift_reg;

always @(posedge clk) begin
    if (rst) begin
        state <= IDLE;
        scl <= 1;
        sda_out <= 1;
        sda_en <= 1;
        busy <= 0;
    end else begin
        case (state)

        IDLE: begin
            scl <= 1;
            sda_out <= 1;
            busy <= 0;
            if (start) begin
                busy <= 1;
                state <= START;
            end
        end

        START: begin
            sda_out <= 0;  // START condition
            scl <= 1;
            shift_reg <= {addr, rw};
            bit_cnt <= 7;
            state <= ADDR;
        end

        ADDR: begin
            scl <= 0;
            sda_out <= shift_reg[bit_cnt];
            scl <= 1;

            if (bit_cnt == 0)
                state <= ACK;
            else
                bit_cnt <= bit_cnt - 1;
        end

        ACK: begin
            sda_en <= 0; // release SDA
            scl <= 1;

            // Assume ACK received (simplified)
            sda_en <= 1;
            shift_reg <= data_in;
            bit_cnt <= 7;
            state <= DATA;
        end

        DATA: begin
            scl <= 0;
            sda_out <= shift_reg[bit_cnt];
            scl <= 1;

            if (bit_cnt == 0)
                state <= STOP;
            else
                bit_cnt <= bit_cnt - 1;
        end

        STOP: begin
            scl <= 1;
            sda_out <= 0;
            sda_out <= 1; // STOP condition
            state <= IDLE;
        end

        endcase
    end
end

endmodule
