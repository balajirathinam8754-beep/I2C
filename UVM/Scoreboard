class i2c_scoreboard extends uvm_scoreboard;

    `uvm_component_utils(i2c_scoreboard)

    uvm_analysis_imp #(
        i2c_sequence_item,
        i2c_scoreboard
    ) analysis_export;


    function new(
        string name = "i2c_scoreboard",
        uvm_component parent = null
    );

        super.new(name, parent);

        analysis_export =
            new("analysis_export", this);

    endfunction


    function void write(i2c_sequence_item item);

        `uvm_info(
            "I2C_SCB",
            $sformatf(
                "Verified I2C transaction: ADDR=0x%02h RW=%0b DATA=0x%02h",
                item.addr,
                item.rw,
                item.data_in
            ),
            UVM_MEDIUM
        );

    endfunction

endclass
